APP_NAME=Skoolyst Module
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Projects/Skoolyst-blgo-management-system/Skoolyst-blgo-management-system/public/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skoolyst_module
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=skoolyst_module_session
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

UPLOAD_MAX_SIZE=10485760

# Shared Skoolyst ad platform (ads.skoolyst.com) — register this app there to get
# an API key and placement codes, then map friendly slot names to those codes in
# config/ads.php.
ADS_API_BASE=https://ads.skoolyst.com/api/v1
ADS_API_KEY=
ADS_CACHE_TTL=30
ADS_PLACEMENT_HOME_TOP=home_top


# Shared Skoolyst Email API (ads.skoolyst.com). Get a key in Admin → Email Accounts →
# API Clients → Add Client on that host, issued for the app name below. Server-side only.
SKOOLYST_EMAIL_API_BASE=https://ads.skoolyst.com/api/v1
SKOOLYST_EMAIL_API_KEY=sk_mail_63d8375f3a9a5e6496e0508cbcbd7e6da960517748288fde
SKOOLYST_EMAIL_SOURCE_APP=skoolyst-blogs
MAIL_ENABLED=true
# true = send right after each response; set false once bin/send-emails.php runs from cron.
MAIL_SEND_INLINE=true
# Optional extra inbox for admin notices (new signups).
MAIL_ADMIN_ADDRESS=


# "Login with Skoolyst" (central identity on skoolyst.com). Get client_id/secret from
# skoolyst.com → Dashboard → Connected Apps → Add App, registering the redirect URI below
# EXACTLY. The button stays hidden until both id and secret are set. Server-side only.
SKOOLYST_AUTH_BASE=https://skoolyst.com
SKOOLYST_AUTH_CLIENT_ID=skl_client_C7t3VdZvGUxwe6TDGUedQAgU
SKOOLYST_AUTH_CLIENT_SECRET=skl_secret_BynyZJRwNvmtnXHOY62AMLKC2IfBOOmIbg1ewPiX
# Defaults to APP_URL + /auth/skoolyst/callback when left empty.
SKOOLYST_AUTH_REDIRECT_URI=http://localhost/Projects/Skoolyst-blgo-management-system/Skoolyst-blgo-management-system/public/auth/skoolyst/callback
