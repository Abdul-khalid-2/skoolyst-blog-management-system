# CSS/JS are served with a ?v=<mtime> query string (see app/Helpers/asset.php),
# so the URL itself changes whenever the file does — safe to cache long-lived.
# Images aren't versioned yet, so they're left on Apache's default caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
